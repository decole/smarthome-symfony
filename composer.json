{
  "type" : "project",
  "license" : "proprietary",
  "minimum-stability" : "stable",
  "prefer-stable" : true,
  "require" : {
    "php": ">=8.3",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-pcntl": "*",
    "ext-sodium": "*",
    "artprima/prometheus-metrics-bundle": "*",
    "bacon/bacon-qr-code": "*",
    "composer/package-versions-deprecated": "*",
    "decole/quasar-iot": "*",
    "doctrine/dbal": "^4",
    "doctrine/doctrine-bundle": "^2.11",
    "doctrine/doctrine-fixtures-bundle": "^4.0",
    "doctrine/doctrine-migrations-bundle": "^3.3",
    "doctrine/orm": "^3.3",
    "dragonmantank/cron-expression": "*",
    "endroid/qr-code": "*",
    "friendsofsymfony/rest-bundle": "^3.6",
    "guzzlehttp/uri-template": "^1.0",
    "irazasyed/telegram-bot-sdk": "*",
    "nelmio/cors-bundle": "^2.4",
    "opensearch-project/opensearch-php": "^2.3",
    "php-mqtt/client": "*",
    "phpdocumentor/reflection-docblock": "^5.3",
    "phpstan/phpdoc-parser": "*",
    "pragmarx/google2fa": "*",
    "predis/predis": "^2.3",
    "psr/http-factory": "^1.1",
    "ramsey/uuid": "*",
    "ramsey/uuid-doctrine": "*",
    "sentry/sentry-symfony": "^5",
    "symfony/asset": "^7.2",
    "symfony/cache": "^7.2",
    "symfony/console": "^7.2",
    "symfony/doctrine-messenger": "^7.2",
    "symfony/dotenv": "^7.2",
    "symfony/expression-language": "^7.2",
    "symfony/flex": "^2",
    "symfony/form": "^7.2",
    "symfony/framework-bundle": "^7.2",
    "symfony/http-client": "^7.2",
    "symfony/intl": "^7.2",
    "symfony/lock": "^7.2",
    "symfony/mailer": "^7.2",
    "symfony/messenger": "^7.2",
    "symfony/mime": "^7.2",
    "symfony/monolog-bundle": "^3.0",
    "symfony/notifier": "^7.2",
    "symfony/process": "^7.2",
    "symfony/property-access": "^7.2",
    "symfony/property-info": "^7.2",
    "symfony/rate-limiter": "^7.2",
    "symfony/runtime": "^7.2",
    "symfony/security-bundle": "^7.2",
    "symfony/serializer": "^7.2",
    "symfony/string": "^7.2",
    "symfony/translation": "^7.2",
    "symfony/twig-bundle": "^7.2",
    "symfony/uid": "^7.2",
    "symfony/validator": "^7.2",
    "symfony/web-link": "^7.2",
    "symfony/yaml": "^7.2",
    "twig/extra-bundle": "^2.12|^3.0",
    "twig/twig": "^2.12|^3.0"
  },
  "config" : {
    "allow-plugins" : {
      "composer/package-versions-deprecated": true,
      "symfony/flex": true,
      "symfony/runtime": true,
      "php-http/discovery": true
    },
    "optimize-autoloader" : true,
    "preferred-install" : {
      "*" : "dist"
    },
    "sort-packages" : true
  },
  "autoload" : {
    "psr-4" : {
      "App\\" : "src/"
    }
  },
  "autoload-dev" : {
    "psr-4" : {
      "App\\Tests\\" : "tests/"
    }
  },
  "replace" : {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*",
    "symfony/polyfill-php83": "*",
    "symfony/polyfill-php84": "*"
  },
  "scripts" : {
    "lint": "phplint --configuration=.phplint.yml",
    "php-cs-check": "php-cs-fixer check --config=.php-cs-fixer.dist.php",
    "php-cs-fixer": "php-cs-fixer fix --diff --verbose --config=.php-cs-fixer.dist.php",
    "phpstan": "phpstan --configuration=phpstan.dist.neon",
    "phpunit": "phpunit --configuration=phpunit.xml.dist",
    "codecept": "codecept run --config=codeception.yml",
    "codecept-build": "codecept build --config=codeception.yml",
    "auto-scripts" : {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd" : [
      "@auto-scripts"
    ],
    "post-update-cmd" : [
      "@auto-scripts"
    ]
  },
  "conflict" : {
    "symfony/symfony" : "*"
  },
  "extra" : {
    "symfony" : {
      "allow-contrib": false,
      "require": "^7.2"
    }
  },
  "require-dev" : {
    "codeception/codeception": "^5.1",
    "codeception/module-asserts": "^3.0",
    "codeception/module-doctrine": "^3.1",
    "codeception/module-phpbrowser": "^3.0",
    "codeception/module-rest": "^3.3",
    "codeception/module-symfony": "^3.3",
    "dama/doctrine-test-bundle": "^8.0",
    "dg/bypass-finals": "^1.6",
    "fakerphp/faker": "^1.23",
    "friendsofphp/php-cs-fixer": "^3.52.0",
    "overtrue/phplint": "^9.0",
    "phpunit/phpunit": "^10.0",
    "roave/security-advisories": "dev-latest",
    "symfony/browser-kit": "^7.2",
    "symfony/css-selector": "^7.2",
    "symfony/debug-bundle": "^7.2",
    "symfony/maker-bundle": "^1.55",
    "symfony/phpunit-bridge": "^7.0",
    "symfony/stopwatch": "^7.2",
    "symfony/web-profiler-bundle": "^7.2"
  }
}
